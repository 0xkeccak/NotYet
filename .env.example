# Notyet — copy to .env (gitignored) and fill in. NEVER commit real values.

# --- Hedera testnet (gate #2: x402 payment via Blocky402) ---
# Create account(s) + claim testnet HBAR at https://portal.hedera.com
# Use ECDSA keys.

# The PAYER = the agent's spend account (this is the account whose key gets
# timelock-encrypted in the real flow). Needs a little testnet HBAR.
HEDERA_NETWORK=testnet
HEDERA_PAYER_ID=0.0.xxxxxxx
HEDERA_PAYER_KEY=0x...            # ECDSA private key (hex)

# The MERCHANT = the x402 service's receiving account (payTo). Can be a second
# portal account. If you only have one, set it equal to the payer for a
# self-pay smoke test (still produces a real settled tx on HashScan).
HEDERA_MERCHANT_ID=0.0.xxxxxxx

# Blocky402 testnet facilitator (keyless, verified live). Leave as-is.
BLOCKY402_URL=https://api.testnet.blocky402.com

# Payment asset for the demo. HBAR (0.0.0) needs no token association.
# Switch to testnet USDC (0.0.429274) later; requires association + Circle faucet.
X402_ASSET=0.0.0
X402_PRICE=$0.01

# --- ENS (Sepolia) — added in the ENS step, not needed for gate #2 ---
# SEPOLIA_RPC_URL=
# ENS_OWNER_KEY=
# ENS_NAME=keccak.eth
