{
  "name": "@keccak002/notyet",
  "version": "1.0.0",
  "type": "module",
  "description": "Scheduled agent authority where the key doesn't exist until its time — timelock-encrypted (drand/tlock) spend keys AND arbitrary secrets (API keys, credentials, tokens). Payments settle via x402 on Hedera, gated on-chain by a PeriodVault.",
  "license": "MIT",
  "author": "0xkeccak",
  "homepage": "https://notyet.up.railway.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xkeccak/NotYet.git"
  },
  "bugs": {
    "url": "https://github.com/0xkeccak/NotYet/issues"
  },
  "keywords": [
    "agent",
    "payments",
    "x402",
    "timelock",
    "drand",
    "tlock",
    "hedera",
    "spend-authority",
    "secrets-management",
    "api-keys",
    "ai-agents"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/sdk/public.js",
  "types": "./dist/sdk/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/public.d.ts",
      "import": "./dist/sdk/public.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LIMITS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"const fs=require('fs');fs.mkdirSync('dist/contracts',{recursive:true});fs.copyFileSync('contracts/PeriodVault.json','dist/contracts/PeriodVault.json')\"",
    "prepublishOnly": "npm run build",
    "start": "tsx start.ts",
    "service": "tsx service/server.ts",
    "web": "tsx web/server.ts",
    "demo": "tsx scripts/full-demo.ts",
    "secret-demo": "tsx scripts/secret-demo.ts",
    "mcp": "tsx bazantic/mcp-server.ts",
    "gate": "tsx scripts/day1-gate.ts",
    "compile:vault": "tsx scripts/compile-vault.ts",
    "gate:vault": "tsx scripts/test-vault.ts",
    "gate:vault:ledger": "tsx scripts/test-vault-ledger.ts",
    "gate:vault:relay": "tsx scripts/test-vault-relay-ledger.ts",
    "id": "tsx scripts/hcs-14-id.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "^2.85.0",
    "@x402/core": "^2.25.0",
    "@x402/hedera": "^2.25.0",
    "tlock-js": "^0.9.0",
    "tweetnacl": "^1.0.3",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@ledgerhq/device-management-kit": "^1.9.0",
    "@ledgerhq/device-signer-kit-ethereum": "^1.18.0",
    "@ledgerhq/device-transport-kit-speculos": "^1.2.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/express": "^5.0.6",
    "@x402/express": "^2.25.0",
    "dotenv": "^17.4.2",
    "drand-client": "^1.4.2",
    "express": "^5.2.1",
    "rxjs": "^7.8.2",
    "solc": "^0.8.37",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "zod": "^4.6.1"
  }
}
